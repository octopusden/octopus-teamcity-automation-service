.gradle
**/build/
!src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Idea generated files
.idea
*.iml
*.ipr
*.iws

# JVM crash logs
hs_err_pid*
replay_pid*

# TeamCity DSL generation output
.teamcity/target/
